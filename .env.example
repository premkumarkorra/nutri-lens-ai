# NutriLens AI Configuration Settings

# Flask details
SECRET_KEY=generate_a_secure_random_key_here

# Database Settings: "sqlite" or "mysql"
DB_TYPE=mysql
SQLITE_DB_PATH=nutrilens.db

MySQL Settings (Uncomment and fill to use MySQL)
DB_TYPE=mysql
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=nutrilens

# Upload settings
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=8388608

# Tesseract Configuration (Required on Windows if not in PATH)
# Example: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Optional: LLM Configuration for explaining analyses
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
